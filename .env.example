# ==============================================================================
# Lane Detection System - Environment Configuration
# Copy this file to .env and update with your values
# ==============================================================================

# Model Configuration
# ------------------------------------------------------------------------------
MODEL_TYPE=yolo                    # Options: yolo, segformer, ensemble, traditional
MODEL_PATH=models/weights/yolov8n-seg.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Processing Configuration
# ------------------------------------------------------------------------------
DEVICE=cuda                        # Options: cuda, cpu, mps (for Mac M1/M2)
BATCH_SIZE=1
IMAGE_SIZE=640
USE_FP16=true                      # Mixed precision for faster inference
NUM_WORKERS=4

# Video Processing
# ------------------------------------------------------------------------------
VIDEO_FPS=30
SKIP_FRAMES=0                      # Process every Nth frame (0 = process all)
MAX_DURATION=0                     # Maximum video duration in seconds (0 = no limit)

# Web Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                    # Auto-reload on code changes (dev only)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                     # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=results/logs/app.log
LOG_TO_CONSOLE=true

# Paths
# ------------------------------------------------------------------------------
DATA_DIR=data
RESULTS_DIR=results
MODELS_DIR=models/weights
UPLOAD_DIR=data/uploads
TEMP_DIR=data/temp

# Advanced Options
# ------------------------------------------------------------------------------
ENABLE_TEMPORAL_SMOOTHING=true
KALMAN_FILTER_ENABLED=true
POLYNOMIAL_ORDER=2                 # For curved lane fitting (2 or 3)
ENABLE_MULTI_LANE=true

# Performance Monitoring
# ------------------------------------------------------------------------------
ENABLE_PROFILING=false
BENCHMARK_MODE=false
